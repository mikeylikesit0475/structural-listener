# Backend image: FastAPI + WebSocket service.
FROM python:3.12-slim AS backend

WORKDIR /app

# Install uv for fast dep resolution.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy the project and install.
COPY pyproject.toml uv.lock* ./
COPY src ./src
RUN uv sync --no-dev --no-install-project 2>/dev/null || uv sync --no-dev
RUN uv pip install --system .

# Expose the FastAPI port.
EXPOSE 8000

CMD ["uvicorn", "structural_listener.service.app:app", "--host", "0.0.0.0", "--port", "8000"]